"search": {
  "endpoints": ["/search/data"],
  "queryParam": "text",
  "pageParam": "offset",
  "mangaRegex": "<a[^>]+href=\"https://weebcentral\\.com/series/([^\"]+)\"[^>]*>\\s*<img[^>]+src=\"([^\"]+)\"[^>]*alt=\"([^\"]+)\""
},
"details": {
  "paths": ["/series/"],
  "titleRegex": "<h1[^>]*>\\s*(.*?)\\s*</h1>",
  "coverRegex": "property=\"og:image\"\\s+content=\"([^\"]+)\"",
  "descriptionRegex": "id=\"section-description\"[^>]*>\\s*<p[^>]*>\\s*(.*?)\\s*</p>",
  "authorRegex": "Author.*?<a[^>]*>([^<]+)</a>",
  "statusRegex": "Status.*?<a[^>]*>([^<]+)</a>"
}
