{
  "id": "mangakatana",
  "name": "MangaKatana",
  "lang": "en",
  "isNsfw": false,
  "version": "1.0.4",
  "baseUrl": "https://mangakatana.com",
  "iconUrl": "https://www.google.com/s2/favicons?domain=mangakatana.com&sz=256",
  "filters": [],
  "search": {
    "endpoints": ["/", "/manga"],
    "queryParam": "search",
    "pageParam": "page",
    "pageSize": 15,
    "paginationType": "page",
    "responseType": "html",
    "mangaRegex": "href=\"(https://mangakatana\\.com/manga/[^\"]+)\"(?:(?!</a>)[\\s\\S])*?src=\"([^\"]+)\"",
    "idGroup": 1,
    "coverGroup": 2,
    "requiredParams": "search_by=m_name"
  },
  "details": {
    "paths": [""],
    "titleRegex": "<h1 class=\"heading\"[^>]*>([^<]+)</h1>",
    "coverRegex": "property=\"og:image\"\\s+content=\"([^\"]+)\"",
    "descriptionRegex": "property=\"og:description\"\\s+content=\"([^\"]+)\"",
    "authorRegex": "class=\"author\"[\\s\\S]*?<a[^>]*>([^<]+)</a>",
    "statusRegex": "class=\"status\"[\\s\\S]*?<div class=\"value\">([^<]+)</div>",
    "genresRegex": "href=\"[^\"]*?/genre/[^\"]+\">([^<]+)</a>"
  },
  "chapters": {
    "listRegex": "class=\"chapter\"[^>]*>[\\s\\S]*?href=\"(https://mangakatana\\.com/manga/[^\"]+/(c[\\d\\.]+))\"",
    "idGroup": 1,
    "nameGroup": 2
  },
  "pages": {
    "cdnRegex": "https?://[^\"]*?(?:mkcdn|mangakatana|blogspot|googleusercontent)[^\"]*?\\.(?:png|jpg|jpeg|webp)"
  }
}
