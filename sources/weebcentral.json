{
  "id": "weebcentral",
  "name": "Weeb Central",
  "lang": "en",
  "isNsfw": false,
  "version": "1.0.8",
  "baseUrl": "https://weebcentral.com",
  "iconUrl": "https://raw.githubusercontent.com/rahulpatel1025/manga-extensions/main/icons/weebcentral.png",
  "filters": [
    {
      "id": "sort",
      "name": "Sort By",
      "type": "select",
      "options": [
        { "label": "Best Match", "value": "Best Match" },
        { "label": "Alphabetical", "value": "Alphabet" },
        { "label": "Popularity", "value": "Popularity" },
        { "label": "Updates", "value": "Updates" },
        { "label": "Released", "value": "Released" },
        { "label": "Added", "value": "Added" }
      ]
    },
    {
      "id": "order",
      "name": "Order",
      "type": "select",
      "options": [
        { "label": "Descending", "value": "Descending" },
        { "label": "Ascending", "value": "Ascending" }
      ]
    },
    {
      "id": "status",
      "name": "Series Status",
      "type": "select",
      "options": [
        { "label": "Any", "value": "Any" },
        { "label": "Ongoing", "value": "Ongoing" },
        { "label": "Completed", "value": "Completed" },
        { "label": "Hiatus", "value": "Hiatus" },
        { "label": "Canceled", "value": "Canceled" }
      ]
    },
    {
      "id": "official",
      "name": "Official Translation",
      "type": "select",
      "options": [
        { "label": "Any", "value": "Any" },
        { "label": "Yes", "value": "True" },
        { "label": "No", "value": "False" }
      ]
    },
    {
      "id": "anime",
      "name": "Anime Adaptation",
      "type": "select",
      "options": [
        { "label": "Any", "value": "Any" },
        { "label": "Yes", "value": "True" },
        { "label": "No", "value": "False" }
      ]
    },
    {
      "id": "adult",
      "name": "Adult Content",
      "type": "select",
      "options": [
        { "label": "Any", "value": "Any" },
        { "label": "Yes", "value": "True" },
        { "label": "No", "value": "False" }
      ]
    }
  ],
  "search": {
    "endpoints": ["/search/data"],
    "queryParam": "text",
    "pageParam": "offset",
    "pageSize": 24,
    "paginationType": "offset",
    "responseType": "html",
    "mangaRegex": "<a[^>]+href=\"(https://weebcentral\\.com/series/[^\"]+)\"[^>]*>[\\s\\S]*?<img[^>]+src=\"([^\"]+)\"[^>]*>[\\s\\S]*?<strong[^>]*>([^<]+)</strong>",
    "idGroup": 1,
    "coverGroup": 2,
    "requiredParams": "author=&sort=Best%20Match&order=Descending&official=Any&anime=Any&adult=Any&display_mode=Full%20Display"
  },
  "details": {
    "paths": [""],
    "titleRegex": "<h1[^>]*>\\s*(.*?)\\s*</h1>",
    "coverRegex": "property=\"og:image\"\\s+content=\"([^\"]+)\"",
    "descriptionRegex": "id=\"section-description\"[^>]*>[\\s\\S]*?<p[^>]*>\\s*(.*?)\\s*</p>"
  },
  "chapters": {
    "listRegex": "<a[^>]+href=\"(https://weebcentral\\.com/chapters/[^\"]+)\"[^>]*>[\\s\\S]*?<span[^>]*>([^<]+)</span>",
    "idGroup": 1,
    "nameGroup": 2
  },
  "pages": {
    "cdnRegex": "https://[^\\s\"'<>]+\\.(?:png|jpg|jpeg|webp)(?:\\?[^\\s\"'<>]*)?"
  }
}
