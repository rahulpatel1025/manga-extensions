{
  "id": "weebcentral",
  "name": "Weeb Central",
  "lang": "English",
  "version": "1.0.5",
  "baseUrl": "https://weebcentral.com",
  "iconUrl": "https://raw.githubusercontent.com/rahulpatel1025/manga-extensions/main/icons/weebcentral.png",
  "search": {
    "endpoints": ["/search/data"],
    "queryParam": "text",
    "pageParam": "offset",
    "pageSize": 24,
    "paginationType": "offset",
    "responseType": "html",
   "mangaRegex": "<a[^>]+href=\"(https://weebcentral\\.com/series/[^\"]+)\"[^>]*>[\\s\\S]*?<img[^>]+src=\"([^\"]+)\"[^>]*>[\\s\\S]*?<strong[^>]*>([^<]+)</strong>",
   "idGroup": 1,
   "titleGroup": 0,
   "coverGroup": 2,
    "requiredParams": "author=&sort=Best%20Match&order=Descending&official=Any&anime=Any&adult=Any&display_mode=Full%20Display"
  },
  "details": {
    "paths": [""],
    "titleRegex": "<h1[^>]*>\\s*(.*?)\\s*</h1>",
    "coverRegex": "property=\"og:image\"\\s+content=\"([^\"]+)\"",
    "descriptionRegex": "id=\"section-description\"[^>]*>[\\s\\S]*?<p[^>]*>\\s*(.*?)\\s*</p>"
  },
  "chapters": {
    "listRegex": "<a[^>]+href=\"(https://weebcentral\\.com/chapters/[^\"]+)\"[^>]*>[\\s\\S]*?<span[^>]*>([^<]+)</span>",
    "idGroup": 1,
    "nameGroup": 2
  },
  "pages": {
    "cdnRegex": "https://[^\\s\"'<>]+\\.(?:png|jpg|jpeg|webp)(?:\\?[^\\s\"'<>]*)?"
  }
}
