{
  "id": "weebcentral",
  "name": "Weeb Central",
  "lang": "English",
  "version": "1.0.0",
  "baseUrl": "https://weebcentral.com",
  "iconUrl": "https://github.com/rahulpatel1025/manga-extensions/blob/main/icons/weebcentral.png?raw=true",
  "search": {
    "endpoints": ["/search/data"],
    "queryParam": "text",
    "pageParam": "offset",
    "mangaRegex": "<a[^>]+href=\"/series/([^\"]+)\"[^>]*>\\s*<img[^>]+src=\"([^\"]+)\"[^>]*alt=\"([^\"]+)\""
  },
  "details": {
    "paths": ["/series/"],
    "titleRegex": "<h1[^>]*>([^<]+)</h1>",
    "coverRegex": "property=\"og:image\"\\s+content=\"([^\"]+)\"",
    "descriptionRegex": "<p[^>]+class=\"[^\"]*description[^\"]*\"[^>]*>([^<]+)</p>",
    "authorRegex": "Author.*?>([^<]+)</a>",
    "statusRegex": "Status.*?>([^<]+)</a>"
  },
  "chapters": {
    "listRegex": "<a[^>]+href=\"/chapters/([^\"]+)\"[^>]*>\\s*<span[^>]*>([^<]+)</span>"
  },
  "pages": {
    "cdnRegex": "https://[^\\s\"']+\\.(?:png|jpg|jpeg|webp)"
  }
}
